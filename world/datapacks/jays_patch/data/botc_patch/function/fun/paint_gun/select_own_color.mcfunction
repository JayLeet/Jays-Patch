# Resolve the player's current BOTC seat colour. Zero means they are not assigned to a player team.
scoreboard players set @s botc_fun_paint_color 0
execute if entity @s[team=01_red] run scoreboard players set @s botc_fun_paint_color 1
execute if entity @s[team=02_orange] run scoreboard players set @s botc_fun_paint_color 2
